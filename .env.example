# ═══════════════════════════════════════════════════════════════
# Animus Hub — Environment Configuration
# ═══════════════════════════════════════════════════════════════

# Server
ANIMUS_PORT=8314
ANIMUS_NODE_NAME=animus-hub

# Authentication — CHANGE THIS!
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
ANIMUS_SERVER_SECRET=

# Chisel tunnel (optional, used with --profile tunnel)
CHISEL_PORT=8315
