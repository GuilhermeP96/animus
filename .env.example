# ═══════════════════════════════════════════════════════════════
# Animus Hub — Environment Configuration
# ═══════════════════════════════════════════════════════════════

# Server
ANIMUS_PORT=8314
ANIMUS_NODE_NAME=animus-hub

# Authentication — CHANGE THIS!
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
ANIMUS_SERVER_SECRET=

# Chisel tunnel (optional, used with --profile tunnel)
CHISEL_PORT=8315

# Strict production peer auth; separate admin credentials are mandatory.
ANIMUS_REQUIRE_NONCE=1
ANIMUS_ADMIN_SECRET=
ANIMUS_ADMIN_PASSWORD=
# Optional authoritative private per-node registry (0600, root/service owner).
ANIMUS_SERVER_PEER_KEYS_FILE=
ANIMUS_ALLOW_INSECURE_DEV_AUTH=False
